# The Unity project sits one level down, in UnitySpringIK/, so the "/" rules below
# carry that prefix. If it ever moves, update them.

# Unity generated
/UnitySpringIK/[Ll]ibrary/
/UnitySpringIK/[Tt]emp/
/UnitySpringIK/[Oo]bj/
/UnitySpringIK/[Ll]ogs/
/UnitySpringIK/[Uu]ser[Ss]ettings/
/UnitySpringIK/[Bb]uild/
/UnitySpringIK/[Bb]uilds/

# Scene Unity writes when running PlayMode tests (trailing * also catches its .meta)
/UnitySpringIK/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Regenerated by Unity every time the project is opened
*.csproj
*.sln
*.user

# IDEs
.vs/
.vscode/
.idea/

# Release artifact -- belongs on GitHub Releases, not in the repo
*.unitypackage
*.unitypackage.meta

# OS
.DS_Store
._*
Thumbs.db
desktop.ini
